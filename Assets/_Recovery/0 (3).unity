  speechBubbleObject: {fileID: 752760899}
  speechText: {fileID: 597996082}
  descriptionObject: {fileID: 1241344549}
  descriptionText: {fileID: 2025476279}
  descriptionDimOverlayObject: {fileID: 227664364}
  descriptionDimOverlayImage: {fileID: 227664366}
  autoCreateDescriptionDimOverlay: 0
  descriptionDimOpacity: 0.493
  descriptionDimBlocksRaycasts: 0
  disableAllBlackDimOverlays: 1
  missionMessagesUseDescriptionDim: 0
  openingDialogueSteps:
  - text: "\uC73C\uC559... \uC5E3\uCDE8!\n\uC5EC\uAE34 \uC5B4\uB514\uC57C...?"
    expressionState: Surprised
    voiceClip: {fileID: 0}
  - text: "\uB098\uB294 \uB204\uAD6C\uC9C0...?\n\uB098...? \uB098\uB294 \uBD84\uBA85..."
    expressionState: Confused
    voiceClip: {fileID: 0}
  - text: "\uC774 \uACF5\uAC04\uC744 \uAE68\uB057\uD558\uAC8C \uC9C0\uD0A4\uB294\n\uCCAD\uACB0\uC694\uC815\uC774\uC5C8\uB358
      \uAC83 \uAC19\uC544!"
    expressionState: Look
    voiceClip: {fileID: 0}
  - text: "\uC73C\uC73C... \uBAB8\uC774 \uB108\uBB34 \uBB34\uAC70\uC6CC.\n\uB0B4
      \uBAB8\uC5D0 \uBD99\uC740 \uBA3C\uC9C0 \uB54C\uBB38\uC778\uAC00 \uBD10..."
    expressionState: Sad
    voiceClip: {fileID: 0}
  - text: "\uC5B4? \uC774\uC0C1\uD558\uB2E4... \uBB54\uAC00\uB97C \uC5BB\uC73C\uBA74\n\uD798\uC774
      \uB0A0 \uAC83 \uAC19\uC740 \uAE30\uBD84\uC774 \uB4E4\uC5B4."
    expressionState: Confused
    voiceClip: {fileID: 0}
  - text: "\uC0DD\uAC01\uB0AC\uC5B4! \uBCF4\uC1A1\uB825!"
    expressionState: Surprised
    voiceClip: {fileID: 0}
  - text: "\uBCF4\uC1A1\uB825\uC774 \uC788\uC73C\uBA74 \uB0B4 \uD798\uC744\n\uC870\uAE08\uC529
      \uB418\uCC3E\uC744 \uC218 \uC788\uC744 \uAC83 \uAC19\uC544!"
    expressionState: Joyful
    voiceClip: {fileID: 0}
  - text: "\uC7A0\uAE50! \uC800\uCABD\uC5D0\uC11C \uC544\uC8FC \uC57D\uD558\uAC8C\n\uBCF4\uC1A1\uB825\uC758
      \uAE30\uC6B4\uC774 \uB290\uAEF4\uC838!"
    expressionState: Look
    voiceClip: {fileID: 0}
  - text: "\uD558\uC9C0\uB9CC \uC544\uC9C1 \uC815\uD655\uD788 \uC5B4\uB514\uC5D0\n\uC228\uC5B4
      \uC788\uB294\uC9C0\uB294 \uBAA8\uB974\uACA0\uC5B4."
    expressionState: Worried
    voiceClip: {fileID: 0}
  - text: "\uB124 \uB3C4\uC6C0\uC774 \uD544\uC694\uD574!"
    expressionState: Focused
    voiceClip: {fileID: 0}
  openingSpeechSteps:
  - "\uC73C\uC559... \uC5E3\uCDE8!\n\uC5EC\uAE34 \uC5B4\uB514\uC57C...?"
  - "\uB098\uB294 \uB204\uAD6C\uC9C0...?\n\uB098...? \uB098\uB294 \uBD84\uBA85..."
